APP_NAME=KIVA API
APP_ENV=development
API_PREFIX=/api
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kivadb
DB_USER=kiva_user
DB_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=kiva-api
JWT_AUDIENCE=kiva-frontend
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

MAX_IMAGE_BYTES=5242880
MAX_DESTINATION_PHOTOS=10

# Almacenamiento de imágenes: local para desarrollo, cloudinary para Render Free.
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
