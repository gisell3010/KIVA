APP_NAME=KIVA API
APP_ENV=test
API_PREFIX=/api
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kivadb_test
DB_USER=kiva_user
DB_PASSWORD=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=kiva-api
JWT_AUDIENCE=kiva-frontend
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

MAX_IMAGE_BYTES=5242880
MAX_DESTINATION_PHOTOS=10

# Las pruebas de imágenes usan almacenamiento local temporal.
IMAGE_STORAGE=local