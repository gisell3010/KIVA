# Referencia para el Web Service gratuito de FastAPI en Render.
# Configura los valores reales desde el Dashboard y no los subas a Git.

APP_ENV=production
DB_HOST=<render-postgres-internal-host>
DB_PORT=5432
DB_NAME=kivadb
DB_USER=kiva_user
DB_PASSWORD=<render-postgres-password>
JWT_SECRET=<secret-of-at-least-32-characters>
CORS_ORIGINS=["https://<frontend>.onrender.com"]
ALLOWED_HOSTS=["<backend>.onrender.com","<frontend>.onrender.com"]
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOG_LEVEL=INFO

# En Render Free las imágenes se guardan fuera del filesystem efímero.
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
MAX_IMAGE_BYTES=5242880
MAX_DESTINATION_PHOTOS=10