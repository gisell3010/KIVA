# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/frontend/dist
/frontend/tmp
/frontend/out-tsc
/frontend/bazel-out
/backend/__pycache__
/backend/.pytest_cache

# Node
/frontend/node_modules
npm-debug.log
yarn-error.log

# Environment files
.env
.env.*
!.env.example
/frontend/.env
/backend/.env

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/
.history/*

# Miscellaneous
/frontend/.angular
.sass-cache/
/connect.lock
/frontend/coverage
/libpeerconnection.log
testem.log
/typings

# Python virtual environments
/backend/.venv
/backend/venv

# Files uploaded by users
/backend/uploads/*
!/backend/uploads/.gitkeep
!/backend/uploads/profiles/
/backend/uploads/profiles/*
!/backend/uploads/profiles/.gitkeep

# System files
.DS_Store
Thumbs.db

# Logs and backups
*.log
*.dump
*.backup
*.sql.gz

# Docker local overrides
docker-compose.override.yml